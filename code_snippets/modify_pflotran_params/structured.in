SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
      OPTIONS
      /
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================

NUMERICAL_METHODS TRANSPORT
  LINEAR_SOLVER
    SOLVER DIRECT
  /
END

#=========================== chemistry ========================================
CHEMISTRY
  PRIMARY_SPECIES
    Tracer
  /

  DATABASE ./hanford.dat

  LOG_FORMULATION

  OUTPUT
    TOTAL
    ALL
  /
END

#=========================== solver options ===================================


#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 20 10 1
  DXYZ
    0.5 
    1.0000e-04 2.6392e-04 6.9651e-04 1.8382e-03 4.8513e-03 \
    1.2803e-02 3.3790e-02 8.9177e-02 2.3535e-01 6.2113e-01    
    1.
  /
END

#=========================== fluid properties =================================

SPECIFIED_VELOCITY
  UNIFORM? NO
  DATASET velocity_field_1cell.h5
END

FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1e-9
END

#=========================== material properties ==============================
MATERIAL_PROPERTY fracture
  ID 1
  POROSITY 1.d0
  ANISOTROPIC_TORTUOSITY
    TORTUOSITY_X 0.
    TORTUOSITY_Y 1.
    TORTUOSITY_Z 1.
  /
END

MATERIAL_PROPERTY matrix
  ID 2
  POROSITY 2e-3
  ANISOTROPIC_TORTUOSITY
    TORTUOSITY_X 0.
    TORTUOSITY_Y 3.169e-2
    TORTUOSITY_Z 3.169e-2
  /
END

#=========================== output options ===================================
OUTPUT
  SNAPSHOT_FILE  
    FORMAT HDF5
    PERIODIC TIME 10 y between 1e2 y and 1e3 y
    PERIODIC TIME 100 y between 1e3 y and 1e4 y
  /
  MASS_BALANCE_FILE  
    PERIODIC TIME 10 y between 1e2 y and 1e3 y
    PERIODIC TIME 100 y between 1e3 y and 1e5 y
    PERIODIC TIME 1000 y between 1e5 y and 1e6 y
    PERIODIC TIME 10000 y between 1e6 y and 1e7 y
  END
END

#=========================== times ============================================
TIME
  FINAL_TIME 1e4 y
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 60 s
  MAXIMUM_TIMESTEP_SIZE 1000 y at 1 h
  MAXIMUM_TIMESTEP_SIZE 1e4 y at 1e6 y
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    0.d0 0.d0 0.d0
    10.d0 1.d0 1.d0
  /
END

REGION fracture
  COORDINATES
    0.  0.   0.
    10. 1e-4 1.
  /
/

REGION matrix
  COORDINATES
    0.  1e-4  0.
    10. 1.    1.
  /
/

REGION west
  COORDINATE 0. 5e-5 0.5
  FACE WEST
END

REGION east
  COORDINATE 10. 5e-5 0.5
  FACE EAST
END

#=========================== transport conditions =============================
TRANSPORT_CONDITION frac_conc
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 frac_constraint
  /
END

TRANSPORT_CONDITION matrix_conc
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 matrix_constraint
  /
END

TRANSPORT_CONDITION inlet_conc
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 inlet_constraint
    3600. frac_constraint
  /
END

CONSTRAINT frac_constraint
  CONCENTRATIONS
    Tracer 1.d-20 T
  /
END

CONSTRAINT matrix_constraint
  CONCENTRATIONS
    Tracer 1.d-20 T
  /
END

CONSTRAINT inlet_constraint
  CONCENTRATIONS
    Tracer 1.d0 T
  /
END


#=========================== condition couplers ===============================
# initial condition
INITIAL_CONDITION
  TRANSPORT_CONDITION frac_conc
  REGION fracture
END

INITIAL_CONDITION
  TRANSPORT_CONDITION matrix_conc
  REGION matrix
END

BOUNDARY_CONDITION east
  TRANSPORT_CONDITION frac_conc
  REGION east
END

BOUNDARY_CONDITION west
  TRANSPORT_CONDITION inlet_conc
  REGION west
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION fracture
  MATERIAL fracture
END

STRATA
  REGION matrix
  MATERIAL matrix
END

END_SUBSURFACE
